{
  "name": "BillPay - stats post with human approval",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "n1",
      "name": "Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.RELAY_API_URL }}/api/stats",
        "options": {}
      },
      "id": "n2",
      "name": "GET /api/stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nconst burned = BigInt(s.burned) / 10n ** 18n;\nconst supply = BigInt(s.totalSupply) / 10n ** 18n;\nconst pending = (s.pendingProposals || []).length;\nconst f = (n) => n.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, ' ');\nconst fr = `📊 BillPay : ${f(burned)} BILL brûlés, offre ${f(supply)} BILL, ${pending} demande(s) solidaire(s) en cours. #BillPay`;\nconst en = `📊 BillPay: ${f(burned)} BILL burned, supply ${f(supply)} BILL, ${pending} open solidarity request(s). #BillPay`;\nconst ru = `📊 BillPay: сожжено ${f(burned)} BILL, предложение ${f(supply)} BILL, открытых заявок: ${pending}. #BillPay`;\nreturn [{ json: { fr, en, ru, approvalText: `Publier ?\\n\\nFR: ${fr}\\n\\nEN: ${en}\\n\\nRU: ${ru}` } }];"
      },
      "id": "n3",
      "name": "Compose FR/EN/RU",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "chatId": "={{ $env.TELEGRAM_APPROVER_CHAT_ID }}",
        "message": "={{ $json.approvalText }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve",
            "disapproveLabel": "Reject"
          }
        },
        "options": {}
      },
      "id": "n4",
      "name": "Human approval (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $env.APPROVE }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Approved AND APPROVE=true",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_PUBLIC_CHAT_ID }}",
        "text": "={{ $('Compose FR/EN/RU').item.json.fr + '\\n\\n' + $('Compose FR/EN/RU').item.json.en + '\\n\\n' + $('Compose FR/EN/RU').item.json.ru }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "n6",
      "name": "Post to Telegram channel",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        -60
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {},
      "id": "n7",
      "name": "Nothing posted",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        80
      ]
    }
  ],
  "connections": {
    "Daily": {
      "main": [
        [
          {
            "node": "GET /api/stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET /api/stats": {
      "main": [
        [
          {
            "node": "Compose FR/EN/RU",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose FR/EN/RU": {
      "main": [
        [
          {
            "node": "Human approval (Telegram)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Human approval (Telegram)": {
      "main": [
        [
          {
            "node": "Approved AND APPROVE=true",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved AND APPROVE=true": {
      "main": [
        [
          {
            "node": "Post to Telegram channel",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Nothing posted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
