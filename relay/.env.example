# --- Lecture on-chain (lecture seule, aucune clé privée) ---
RPC_URL=https://mainnet.base.org
CHAIN_ID=8453
TOKEN_ADDRESS=
LOTS_ADDRESS=
SOLIDARITY_ADDRESS=
AUTOLIQ_ADDRESS=
# Paires AMM (type Uniswap V2) ; au moins l'une des deux
PAIR_USDC_ADDRESS=
PAIR_WETH_ADDRESS=
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Offre initiale en unités entières de BILL (pour calculer le total brûlé)
INITIAL_SUPPLY=1000000000
# Adresses supplémentaires exclues du circulant (séparées par des virgules)
EXCLUDED_ADDRESSES=
DEPLOY_BLOCK=0
LOG_CHUNK=5000

# --- API ---
PORT=8787
CORS_ORIGIN=*
CACHE_TTL_SECONDS=30

# --- Publisher ---
STATE_FILE=data/publisher-state.json
# Jalons de burn en BILL (séparés par des virgules)
BURN_MILESTONES=1000000,10000000,100000000
# Par défaut : simulation, rien n'est publié
DRY_RUN=true
# Aucune publication réelle sans APPROVE=true ET une approbation humaine de chaque post
APPROVE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LANGS=fr,en,ru
# X : jeton utilisateur OAuth2 (scope tweet.write)
X_ACCESS_TOKEN=
X_LANGS=en
